[sqlfluff]
templater = dbt
dialect = bigquery
max_line_length = 100
indent_unit = space

[sqlfluff:indentation]
tab_space_size = 4

[sqlfluff:rules]
tab_space_size = 4
indent_unit = space
comma_style = trailing

[sqlfluff:rules:L010]
capitalisation_policy = lower

[sqlfluff:rules:L030]
capitalisation_policy = lower

[sqlfluff:rules:L014]
# Unquoted identifiers
extended_capitalisation_policy = lower
